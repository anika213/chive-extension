# Copy to .env (gitignored) and fill in. Only the keys for backends you use are needed.

# --- API keys --------------------------------------------------------------
ANTHROPIC_API_KEY=            # anthropic:... specs (investigator / judge / grader in the paper)
OPENROUTER_API_KEY=           # openrouter:... specs
OPENAI_API_KEY=               # openai:...@url specs (vLLM ignores it)
HF_TOKEN=                     # gated HF models / scripts/download_data.py

# --- Backend spec per pipeline role (read by introspection/run_on_dataset.py) ---
# Forms: anthropic:MODEL | openrouter:MODEL | vllm:MODEL@http://host:port | openai:MODEL@https://host/v1 | mock:NAME
CHIVE_TARGET_LLM=             # model being investigated, e.g. openrouter:qwen/qwen3-32b@SiliconFlow (pin a provider that honors no-think)
CHIVE_INVESTIGATOR_LLM=       # e.g. anthropic:claude-opus-4-6
CHIVE_JUDGE_LLM=              # screening + verification, e.g. anthropic:claude-opus-4-6
CHIVE_GRADER_LLM=             # per-completion yes/no grader, e.g. anthropic:claude-sonnet-4-6
CHIVE_SYNTH_LLM=              # stage-5 training-data synthesis (or --set skip_stage5_synthetic=true)
